# ==============================================================================
# Environment Configuration Template for PeTTa Agentic AI Framework
# Copy this file to .env and configure your desired credentials.
# ==============================================================================

# Primary LLM Provider Selection (gemini, openai, deepseek, generic_openai)
LLM_PROVIDER=gemini
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# --- OpenAI Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- DeepSeek Configuration ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# --- Generic OpenAI-Compatible Configuration ---
# Compatible with OpenRouter, Together AI, Groq, Ollama, vLLM, LocalAI, etc.
GENERIC_API_KEY=your_generic_api_key_here
GENERIC_BASE_URL=https://api.groq.com/openai/v1
GENERIC_MODEL=llama-3.3-70b-versatile
